# TRXT Validation - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# Data files (too large for git)
data/sparc/*.mrt
!data/sparc/sample_rotmod.mrt
!data/sparc/MassModels_Lelli2016c.mrt
data/sparc/*.dat
data/planck/*

# Outputs (regenerated on each run)
outputs/runs/*/
!outputs/runs/.gitkeep

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
