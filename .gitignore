# ──────────────────────────────────────────────
# TRXT — .gitignore
# ──────────────────────────────────────────────

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl

# Virtual environments
.venv/
venv/
ENV/

# IDE / Editor
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# LaTeX auxiliary files
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.fls
*.fdb_latexmk
*.synctex.gz
*.bbl
*.blg
*.nav
*.snm
*.vrb

# Compiled PDFs
*.pdf

# Manuscript / research report (private — not published on GitHub)
manuscript/

# Old top-level LaTeX files
TRXT_Research_Report_V7_FINAL.tex
TRXT_V7_Release_Description.tex
TRXT_V7_Release_Description.md
%OUTDIR%/

# Large data files (download separately — see data/README.md)
data/sparc/*.dat
data/planck_2018/*.fits

# Archive of superseded versions (not needed for reproduction)
_archive/

# source_code/ IS tracked (prediction scripts + verification code)

# Temporary / OS files
*.tmp
*.bak
*.orig

# Jupyter checkpoints
.ipynb_checkpoints/

# NPZ result caches (regenerated by run_all.py)
results/**/*.npz
